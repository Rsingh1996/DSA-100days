/*
Top K Frequent Elements
Example:
[1,1,1,2,2,3], k = 2
Output:
[1,2]
*/

const topKFrequentElements = (arr, k) => {
    let map = {}
    
    // adding value and their count
    for(let num of arr){
        map[num] = (map[num] || 0) + 1
    }
    const sorted = Object.entries(map)
        .sort((a,b) => b[1] - a[1]);
        
    return sorted.slice(0,k).map(item => Number(item[0]));
}
console.log(topKFrequentElements([1,1,1,2,2,3], 2));
