/*
Valid Parentheses
Example:
"()[]{}" → true
"(]" → false
"([{}])" → true
*/

const validParentheses = (str) => {
    const stack = [];
    
    for(let char of str){
        if(char === "(" || char === "{" || char === "[" ) {
            stack.push(char);
        }
      if (char === ")" || char === "}" || char === "]"){
        if(stack.length === 0 ) return false;
        
        let top = stack[stack.length-1];
        if( (char === ")" && top !== "(") ||
        (char === "}" && top !== "{" ) ||
        (char === "]" && top !== "[")
        ) { 
            return false;
        }
         stack.pop()
        } 
    }
    
    return stack.length === 0;
   
    
}
console.log(validParentheses("()[]{}"));

const validParenthesesUsingMap = (str) => {
    const map = {
        ")" : "(",
        "}" : "{",
        "]" : "["
        };
    
    let stack = [];    
    
    for(let char of str){
       if(!map[char]){
           stack.push(char)
       }else if(stack.pop() !== map[char]){
           return false;
       }
    }
    return stack.length === 0;
    
}
console.log(validParenthesesUsingMap("()[]{(]}"));
